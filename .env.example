# Environment variables

# Runtime
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="HybridTurtle"
APP_TIMEZONE="Europe/London"

# Database
# Stable runtime path in this workspace uses SQLite.
# For a future Postgres migration, replace with a postgresql:// URL once the Prisma provider is migrated.
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-change-in-production"
# Encryption key for broker API credentials (defaults to NEXTAUTH_SECRET if not set)
ENCRYPTION_SECRET="your-secret-key-change-in-production"
CRON_SECRET="set-a-strong-random-secret"
# API auth is enforced by default. Only set this to true for isolated local troubleshooting.
DISABLE_API_AUTH="false"

# Market Data — Yahoo Finance (no API key needed!)
MARKET_DATA_PROVIDER="yahoo"
# Alpha Vantage API key (optional fallback — free tier: 25 req/day, 5/min)
# Get a free key at https://www.alphavantage.co/support/#api-key
# ALPHA_VANTAGE_API_KEY="your-alpha-vantage-api-key"
# EODHD API key (optional fallback — required only when MARKET_DATA_PROVIDER=eodhd)
# EODHD_API_KEY="your-eodhd-api-key"

# Broker adapter: disabled (safe default), mock (demo data), trading212 (live)
BROKER_ADAPTER="disabled"

# Telegram Bot (optional — for trade alerts)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_CHAT_ID="your-chat-id"
TELEGRAM_WEBHOOK_SECRET="set-a-strong-random-secret"

# Trading 212 API Keys (optional — alternative to storing in DB via Settings page)
# If set, these take priority over database values. Settings page shows as read-only.
# T212_INVEST_API_KEY=
# T212_ISA_API_KEY=
# T212_INVEST_ACCOUNT_ID=
# T212_ISA_ACCOUNT_ID=
# T212_ENVIRONMENT=live
ENABLE_BROKER_TRADING="false"
ENABLE_AUTO_SUBMISSION="false"

# Automated trading — scans, buys, and places stops automatically
# Set to true only after connecting T212 and testing with ENABLE_BROKER_TRADING
ENABLE_AUTO_TRADING="false"
# Max trades per auto-trade session (default 2)
# AUTO_TRADE_MAX_PER_SESSION=2

# Nightly Run Schedule (cron expression - 9:30 PM UK)
NIGHTLY_CRON="30 21 * * *"

# Alerts / ML
ENABLE_TELEGRAM_ALERTS="false"
MODEL_SERVICE_URL="http://localhost:8000"
ENABLE_ML_SCORING="false"

# Jev auto-trade veto (see docs/TYPESAFE-INTEGRATION.md). Needs TYPESAFE_REVIEW_ENABLED=true.
# veto = Jev may block, never add, an A-grade buy; any Jev failure lets the trade proceed.
JEV_AUTO_TRADE_GATE="off"
JEV_VETO_PASS_PROBABILITY="0.6"
