{
  "name": "hybridturtle",
  "version": "6.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "start:lan": "next start -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:verify": "node scripts/db-verify.mjs",
    "db:reconcile": "node scripts/reconcile-schema-drift.mjs",
    "db:backup-cleanup": "node scripts/cleanup-db-backups.mjs",
    "refresh:daily-bars": "tsx scripts/refresh-universe-daily-bars.ts",
    "refresh:fx-bars": "tsx scripts/refresh-backtest-fx-bars.ts",
    "market-data:scheduler": "tsx scripts/start-market-data-scheduler.ts",
    "broker:sync": "tsx scripts/broker-sync.ts",
    "broker:scheduler": "tsx scripts/start-broker-sync-scheduler.ts",
    "portfolio:view": "tsx scripts/show-portfolio.ts",
    "workflow:run": "tsx scripts/run-tonight-workflow.ts",
    "workflow:card": "tsx scripts/show-tonight-workflow-card.ts",
    "signals:run": "tsx scripts/run-signal-scan.ts",
    "signals:view": "tsx scripts/show-signal-candidates.ts",
    "risk:state": "tsx -e \"import('dotenv/config').then(() => import('./packages/risk/src').then(m => m.getAccountRiskState().then(s => console.log(JSON.stringify(s, null, 2)))))\"",
    "stops:view": "tsx scripts/show-stop-dashboard.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "smoke": "tsx scripts/smoke-buy-flow.ts && node scripts/audit-scheduled-tasks.mjs",
    "tasks:audit": "node scripts/audit-scheduled-tasks.mjs",
    "typesafe:review": "tsx src/cron/typesafe-review.ts",
    "tasks:cleanup-retired": "node scripts/cleanup-retired-scheduled-tasks.mjs",
    "tasks:register-all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-all-tasks.ps1",
    "tasks:apply-limits": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/apply-task-time-limits.ps1",
    "complexity:audit": "node scripts/audit-complexity-surface.mjs",
    "complexity:baseline": "node scripts/audit-complexity-surface.mjs --write-baseline",
    "simplification:audit": "node scripts/audit-simplification-ledger.mjs",
    "sanity:live": "tsx scripts/sanity-live.ts",
    "sanity:scheduler": "node scripts/audit-scheduled-tasks.mjs",
    "audit:harness": "npx tsx scripts/audit_harness.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:auto-migrate": "node scripts/auto-migrate.mjs",
    "db:push": "echo ⚠ Do not use db push — use npm run db:migrate instead && exit 1",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "db:studio": "npx prisma studio",
    "db:status": "prisma migrate status",
    "fix:account-types": "tsx scripts/fix-account-types.ts",
    "system:check": "tsx scripts/system-check.ts",
    "test:e2e": "tsx scripts/test-telegram.ts && tsx scripts/test-e2e-market.ts && tsx scripts/test-e2e-system.ts",
    "postinstall": "prisma generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-avatar": "^1.0.4",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@typesafe-ai/sdk": "0.6.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dotenv": "^16.6.1",
    "lightweight-charts": "^4.1.3",
    "lucide-react": "^0.462.0",
    "next": "15.5.22",
    "next-auth": "4.24.15",
    "node-cron": "^4.2.1",
    "p-limit": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.0",
    "tailwind-merge": "^2.2.1",
    "tailwindcss-animate": "^1.0.7",
    "yahoo-finance2": "^3.13.0",
    "zod": "^4.3.6",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.11.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.15",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "8.5.25",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "postcss": "8.5.25"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --no-warn-ignored",
    "*.{js,jsx,mjs}": "eslint --no-warn-ignored"
  }
}
